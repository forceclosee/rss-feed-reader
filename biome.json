{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!docs",
			"!data",
			"!tests/fixtures",
			"!drizzle",
			"!**/routeTree.gen.ts",
			"!**/worker-configuration.d.ts",
			"!**/dist",
			"!**/.wrangler",
			"!**/.output",
			"!**/playwright-report",
			"!**/test-results",
			"!**/coverage"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noDescendingSpecificity": "off"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "on",
					"fix": "safe"
				},
				"useTailwindStaticClassStrings": "on"
			},
			"complexity": {
				"noImportantStyles": "off"
			}
		},
		"domains": {
			"tailwind": "all"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"bracketSameLine": true
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"parser": {
			"tailwindDirectives": true
		}
	}
}
