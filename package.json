{
	"name": "frontpage",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsc --noEmit",
		"preview": "vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.dev.vars --import tsx src/scripts/seed.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@neondatabase/serverless": "^1.2.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.7",
		"@ui-sdk/core": "^0.1.0-beta.13",
		"@ui-sdk/react": "^0.1.0-beta.13",
		"drizzle-orm": "^0.45.4",
		"fast-xml-parser": "^5.12.1",
		"lucide-react": "^1.77.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sanitize-html": "^2.18.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@cloudflare/vite-plugin": "^1.70.1",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/sanitize-html": "^2.16.2",
		"@vitejs/plugin-react": "^6.3.0",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^31.0.1",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	}
}
